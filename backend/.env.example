# Backend environment variables
# Copy to .env and fill in your values -- never commit .env

NODE_ENV=development
PORT=4000

# JWT
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=24h

# PostgreSQL (via Prisma)
DATABASE_URL=postgresql://postgres:password@localhost:5432/attesta_db

# Blockchain
RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
CONTRACT_ADDRESS=0xYourDeployedContractAddress
# Backend wallet private key (this wallet pays gas for issueCredential txs)
BACKEND_PRIVATE_KEY=your_backend_wallet_private_key_here

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000
